<?xml version="1.0"?>
<!-- Kinematic model of a KUKA KR6 R900 sixx class robot, after ROS-Industrial kuka_experimental
     (kuka_kr6_support, Apache-2.0). Visual/collision geometry omitted; kinematics only.
     `flange` follows the KUKA flange convention (X out of the flange);
     `tool0` follows the ROS-Industrial convention (Z out of the flange). -->
<robot name="kuka_kr6_r900_sixx">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="link_4"/>
  <link name="link_5"/>
  <link name="link_6"/>
  <link name="flange"/>
  <link name="tool0"/>
  <joint name="joint_a1" type="revolute">
    <origin xyz="0 0 0.400" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="0" lower="-2.967" upper="2.967" velocity="6.283"/>
  </joint>
  <joint name="joint_a2" type="revolute">
    <origin xyz="0.025 0 0" rpy="0 0 0"/>
    <parent link="link_1"/><child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="-3.316" upper="0.785" velocity="5.236"/>
  </joint>
  <joint name="joint_a3" type="revolute">
    <origin xyz="0.455 0 0" rpy="0 0 0"/>
    <parent link="link_2"/><child link="link_3"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="-2.094" upper="2.723" velocity="6.283"/>
  </joint>
  <joint name="joint_a4" type="revolute">
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <parent link="link_3"/><child link="link_4"/>
    <axis xyz="-1 0 0"/>
    <limit effort="0" lower="-3.229" upper="3.229" velocity="6.649"/>
  </joint>
  <joint name="joint_a5" type="revolute">
    <origin xyz="0.420 0 0" rpy="0 0 0"/>
    <parent link="link_4"/><child link="link_5"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="-2.094" upper="2.094" velocity="6.772"/>
  </joint>
  <joint name="joint_a6" type="revolute">
    <origin xyz="0.080 0 0" rpy="0 0 0"/>
    <parent link="link_5"/><child link="link_6"/>
    <axis xyz="-1 0 0"/>
    <limit effort="0" lower="-6.109" upper="6.109" velocity="10.734"/>
  </joint>
  <joint name="joint_a6-flange" type="fixed">
    <parent link="link_6"/><child link="flange"/>
  </joint>
  <joint name="flange-tool0" type="fixed">
    <origin xyz="0 0 0" rpy="0 1.5707963267948966 0"/>
    <parent link="flange"/><child link="tool0"/>
  </joint>
</robot>
